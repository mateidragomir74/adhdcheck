# Names only. Copy to .env.local (gitignored) and fill the values there. Never commit values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RESEND_API_KEY=
# Sender of every email (FR-50 and the paid report). An address on a domain verified in Resend. Unset outside production, the Resend test sender is used.
EMAIL_FROM=
# Public address of the site, no trailing slash (Stripe return URLs and email links). Required for checkout and for emails with a link.
SITE_URL=
DEMO_PARENT_EMAIL=
# Local only, for scripts/demo-rehearsal.mts; the app never reads it, so it does not go in Vercel.
DEMO_PARENT_PASSWORD=
# Set to 1 to serve the dev game pages under /play in production; read at build, off by default.
GAME_HARNESS=
